    <model name="chair1_1"><static>true</static><pose>3.0 1.2 0.225 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.4 0.4 0.45</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual></link></model>
